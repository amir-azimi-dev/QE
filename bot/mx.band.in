 &control
        calculation='bands'
	verbosity='high',
        restart_mode='from_scratch',
 	 prefix='mx',
  	 pseudo_dir = '/home/microlab/Rajabi/psuedo',
        outdir='./tmp/'
 /

 &system
    	ibrav=0,
	ntyp=2,
	nat=5,
	ecutwfc = 60.0,
	 occupations='smearing',
	 smearing = 'gaussian',
	 degauss  = 0.01,
 /

 &electrons
 diagonalization = 'david'
 conv_thr = 1.0d-10
 mixing_beta = 0.3
/

&IONS
/

&CELL
	cell_dynamics = 'bfgs',
	cell_dofree = '2Dxy'
/

