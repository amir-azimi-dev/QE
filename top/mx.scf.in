&control
         calculation='scf'
         restart_mode='from_scratch',
 	 prefix='mx',
  	 pseudo_dir = './pseudo/',
         outdir='./tmp/'       
 /
 
 &system
    	ibrav=0,
	ntyp=2,
	nat=5,
	ecutwfc = 60.0,
	 occupations='smearing',
	 smearing = 'gaussian',
	 degauss  = 0.01,
 /
 
 &electrons
        diagonalization = 'david'
        conv_thr =  1.0d-10
        mixing_beta = 0.3
 /
    
